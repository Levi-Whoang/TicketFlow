# 应用
APP_NAME=TicketFlow
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=DEBUG

# MySQL
MYSQL_DATABASE=ticketflow
MYSQL_USER=ticketflow
MYSQL_PASSWORD=ticketflow
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_PORT=3306
DATABASE_URL=mysql+asyncmy://ticketflow:ticketflow@127.0.0.1:3306/ticketflow?charset=utf8mb4
SYNC_DATABASE_URL=mysql+pymysql://ticketflow:ticketflow@127.0.0.1:3306/ticketflow?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://ticketflow:ticketflow@127.0.0.1:3306/ticketflow_test?charset=utf8mb4

# Redis 与 Celery
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# JWT
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ticketflow.local
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

# 跨域
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 演示数据
DEMO_SEED_ENABLED=true
